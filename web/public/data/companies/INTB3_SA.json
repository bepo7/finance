{"ticker": "INTB3.SA", "country": "BR", "segment": "semis", "chain": "Hardware & montagem", "profile": {"longName": "Intelbras S.A. - Ind\u00fastria de Telecomunica\u00e7\u00e3o Eletr\u00f4nica Brasileira", "shortName": "INTELBRAS   ON      NM", "sector": "Industrials", "industry": "Building Products & Equipment", "currency": "BRL", "financialCurrency": "BRL", "exchange": "SAO", "marketCap": 5029234688.0, "sharesOutstanding": 327211110.0, "beta": 0.014, "totalDebt": 889217024.0, "totalCash": 1556178944.0, "currentPrice": 15.37, "regularMarketPrice": 15.37, "trailingPE": 8.04712, "forwardPE": 7.7021756, "enterpriseValue": 4385666560.0, "enterpriseToEbitda": 7.478, "enterpriseToRevenue": 0.953, "ebitdaMargins": 0.12738, "operatingMargins": 0.11768, "grossMargins": 0.318, "revenueGrowth": 0.046, "fiftyTwoWeekLow": 0.0, "fiftyTwoWeekHigh": 20.06, "longBusinessSummary": "Intelbras S.A. - Ind\u00fastria de Telecomunica\u00e7\u00e3o Eletr\u00f4nica Brasileira engages in the manufacturing, developing, and sale of electronic security equipment and electronic surveillance and monitoring services in Brazil. The company operates through three segments, Security, Information and Communication Technology (ICT), and Energy. It offers electronic safety products and solutions, including It offers electronic safety products and solutions, including alarms, storage, cameras, condominium communication, corporate access control, locks, digital video recorders, fire and intercom products, vehicle monitoring, sensors, emergency signaling, software and application products, and accessories; and networks products and solutions comprise 5G and corporate Wi-Fi products, racks, routers, switches, outdoor radios, optical fiber and passive products, PoE injectors, USB adapters, software and apps, and cables. The company also provides communication related products and solutions, such as webcams, projectors, wireless mouse and keyboards, cloud solutions, antennas and converters, phone centrals, appliance and conference products, gateways, headsets, radio communicators, smart boxes and controls, smart speakers, software and applications, and phones; and energy related products and solutions that includes electric vehicle chargers, UPS, batteries, smart, fonts, electronic protectors, surge protectors, USB accessories, and illumination presence sensors. In addition, it offers on grid solutions, which includes solar panels, attachment structures, on grid inverters, string boxes, and accessories; and off grid solutions, such as illumination products, mounting structures, outdoor cabinets, solar drive and panels, solar bomb, and off grid generators and inverters. Intelbras S.A. - Ind\u00fastria de Telecomunica\u00e7\u00e3o Eletr\u00f4nica Brasileira was incorporated in 1974 and is headquartered in S\u00e3o Jos\u00e9, Brazil.", "fullTimeEmployees": null, "website": "https://www.intelbras.com", "price": 15.37}, "financials": {"years": [2022, 2023, 2024, 2025], "fiscalYearEnd": ["2022-12-31", "2023-12-31", "2024-12-31", "2025-12-31"], "is": {"revenue": [4232623000.0, 4103676000.0, 4756146000.0, 4460379000.0], "cogs": [3031094000.0, 2826669000.0, 3293517000.0, 3117798000.0], "grossProfit": [1201529000.0, 1277007000.0, 1462629000.0, 1342581000.0], "opex": [845620000.0, 877714000.0, 1056119000.0, 1048559000.0], "ebit": [355909000.0, 399293000.0, 406510000.0, 294022000.0], "ebitda": [610223000.0, 710286000.0, 694756000.0, 701649000.0], "da": [69648000.0, 79240000.0, 97834000.0, 116625000.0], "interestExpense": [70512000.0, 114352000.0, 82087000.0, 104835000.0], "pretaxIncome": [470063000.0, 516694000.0, 514835000.0, 480189000.0], "tax": [-9185000.0, -28864000.0, -13577000.0, -3544000.0], "netIncome": [480262000.0, 544231000.0, 528934000.0, 482772000.0]}, "bs": {"totalAssets": [4987382000.0, 4888285000.0, 5569521000.0, 5325682000.0], "totalLiabilities": [2739100000.0, 2264763000.0, 2602985000.0, 2311511000.0], "equity": [2231037000.0, 2600824000.0, 2941909000.0, 29915000