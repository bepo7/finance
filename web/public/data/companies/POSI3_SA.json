{"ticker": "POSI3.SA", "country": "BR", "segment": "semis", "chain": "Hardware & montagem", "profile": {"longName": "Positivo Tecnologia S.A.", "shortName": "POSITIVO TECON      NM", "sector": "Technology", "industry": "Computer Hardware", "currency": "BRL", "financialCurrency": "BRL", "exchange": "SAO", "marketCap": 466646368.0, "sharesOutstanding": 138470742.0, "beta": 0.148, "totalDebt": 1339917952.0, "totalCash": 480300000.0, "currentPrice": 3.37, "regularMarketPrice": 3.37, "trailingPE": 37.444443, "forwardPE": 1.9982922, "enterpriseValue": 1326264448.0, "enterpriseToEbitda": 5.165, "enterpriseToRevenue": 0.361, "ebitdaMargins": 0.06998, "operatingMargins": 0.07301, "grossMargins": 0.24039, "revenueGrowth": 0.238, "fiftyTwoWeekLow": 0.0, "fiftyTwoWeekHigh": 5.21, "longBusinessSummary": "Positivo Tecnologia S.A., together with its subsidiaries, develops, manufactures, sells, and distributes hardware, software, and information technology (IT) solutions in Brazil and internationally. The company operates through Consumer, Public Institutions, and Corporate segments. It offers computers, smartphones, tablets, accessories, smart home and environment devices, office products, electronic security devices, servers, mobile payment terminals, payment machines, and IT infrastructure products; education technology solutions, including self-service kiosks, data collection devices for demographic surveys, and electronic voting machines; and medical, laboratory, and communication equipment. The company also engages in the rental of IT and mobility (hardware as a service) equipment; provision of IT technical support and managed IT services; sale of pedagogic application systems and school administration products; technical-pedagogical planning and support; and representation, sale, implementation, training, support, and technical assistance for equipment, as well as for technical, technological, and scientific teaching systems. It serves end consumers, residential condominiums, businesses, schools, and public institutions. The company was formerly known as Positivo Inform\u00e1tica S.A. and changed its name to Positivo Tecnologia S.A. in April 2017. Positivo Tecnologia S.A. was incorporated in 1989 and is headquartered in Curitiba, Brazil.", "fullTimeEmployees": 8364.0, "website": "https://www.positivotecnologia.com.br", "price": 3.37}, "financials": {"years": [2022, 2023, 2024, 2025], "fiscalYearEnd": ["2022-12-31", "2023-12-31", "2024-12-31", "2025-12-31"], "is": {"revenue": [4398539000.0, 3474259000.0, 3332332000.0, 3080456000.0], "cogs": [3796478000.0, 2864102000.0, 2764289000.0, 2511831000.0], "grossProfit": [602061000.0, 610157000.0, 568043000.0, 568625000.0], "opex": [-25329000.0, 103365000.0, 263031000.0, 345811000.0], "ebit": [627390000.0, 506792000.0, 305012000.0, 222814000.0], "ebitda": [636733000.0, 552839000.0, 329020000.0, 302186000.0], "da": [49891000.0, 56230000.0, 57417000.0, 82612000.0], "interestExpense": [279858000.0, 242458000.0, 169467000.0, 199375000.0], "pretaxIncome": [306984000.0, 254151000.0, 102136000.0, 20199000.0], "tax": [627000.0, 3269000.0, 17098000.0, 7965000.0], "netIncome": [303117000.0, 246760000.0, 80378000.0, 8638000.0]}, "bs": {"totalAssets": [4199825000.0, 4581833000.0, 4466987000.0, 4473551000.0], "totalLiabilities": [2793505000.0, 2985406000.0, 2820866000.0, 2897559000.0], "equity": [1396026000.0, 1587400000.0, 1635829000.0, 1575992000.0], "cash": [426576000.0, 591375000.0, 566929000.0, 618362000.0], "receivables": [1132483000.0, 1326360000.0, 860937000.0, 741297000.0], "inventory": [1321856000.0, 1207360000.0, 1062313000.0, 1095799000.0], "currentAssets": [3430062000.0, 3575173000.0, 2967747000.0, 2821028000.0], "payables": [594245000.0, 823121000.0, 658247000.0, 692278000.0], "currentLiabilities": [1773213000.0, 1934265000.0, 1503102000.0, 1667997000.0], "ppe": [110987000.0, 146818000.0, 155481000.0, 144523000.0], "totalDebt": [1561600000.0, 1419095000.0, 1318010000.0, 1296652000.0]}, "cf": {"